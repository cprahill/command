{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/phone", "destination": "/phone/index.html" },
    { "source": "/phone/", "destination": "/phone/index.html" },
    { "source": "/ctl", "destination": "/phone/index.html" },
    { "source": "/ctl/", "destination": "/phone/index.html" }
  ],
  "redirects": [
    { "source": "/harness", "destination": "/neural/", "permanent": true },
    { "source": "/harness/(.*)", "destination": "/neural/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "functions": {
    "api/paper-desk.js": {
      "maxDuration": 10
    }
  }
}

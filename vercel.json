{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/harness", "destination": "/neural/", "permanent": true },
    { "source": "/harness/(.*)", "destination": "/neural/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/paper-desk.js": {
      "maxDuration": 10
    }
  }
}
